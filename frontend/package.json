{
  "name": "aifordev-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint . --ext .ts,.vue",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "spec:lint": "redocly lint ../api-spec/openapi.yaml --config ../api-spec/redocly.yaml",
    "spec:bundle": "redocly bundle ../api-spec/openapi.yaml -o ../api-spec/dist/openapi.json --config ../api-spec/redocly.yaml",
    "generate:api": "openapi-typescript ../api-spec/dist/openapi.json -o ./api/generated/schema.d.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@nuxt/ui": "^4.8.2",
    "@pinia/nuxt": "^0.11.3",
    "@vee-validate/rules": "^4.15.1",
    "@vee-validate/zod": "^4.15.1",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.49.0",
    "@redocly/cli": "^2.32.2",
    "@types/node": "^25.9.3",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.4.1",
    "happy-dom": "^20.10.2",
    "jsdom": "^29.1.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.2.0"
  },
  "overrides": {
    "vite": "^7.3.5"
  }
}
