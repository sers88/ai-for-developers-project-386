{
  "openapi": "3.1.0",
  "info": {
    "title": "AiForDev API",
    "version": "0.1.0",
    "description": "REST API for the AiForDevelopers platform"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api",
      "description": "Local backend"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Authentication & registration"
    },
    {
      "name": "users",
      "description": "User profile"
    },
    {
      "name": "schedules",
      "description": "Schedule & availability management"
    },
    {
      "name": "calendar",
      "description": "Google Calendar integration"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register a new user",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "emailExists": {
                    "summary": "Email already registered",
                    "value": {
                      "message": "Email already registered"
                    }
                  },
                  "validation": {
                    "summary": "Validation error",
                    "value": {
                      "message": "email: Invalid email format"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Authenticate user",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials or validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidCredentials": {
                    "summary": "Invalid email or password",
                    "value": {
                      "message": "Invalid email or password"
                    }
                  },
                  "validation": {
                    "summary": "Validation error",
                    "value": {
                      "message": "email: Invalid email format"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh access token",
        "operationId": "refreshToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New access token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid, expired, or missing refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid": {
                    "summary": "Invalid refresh token",
                    "value": {
                      "message": "Invalid refresh token"
                    }
                  },
                  "notFound": {
                    "summary": "Refresh token not found",
                    "value": {
                      "message": "Refresh token not found"
                    }
                  },
                  "expired": {
                    "summary": "Refresh token expired",
                    "value": {
                      "message": "Refresh token expired"
                    }
                  },
                  "missing": {
                    "summary": "Refresh token is required",
                    "value": {
                      "message": "refreshToken: Refresh token is required"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/oauth2/google": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Initiate Google OAuth2 flow",
        "operationId": "googleOAuth",
        "responses": {
          "302": {
            "description": "Redirect to Google OAuth consent screen"
          }
        }
      }
    },
    "/api/auth/oauth2/google/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Google OAuth2 callback",
        "operationId": "googleOAuthCallback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Authorization code from Google"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to frontend with tokens",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "{FRONTEND_URL}/auth/callback?accessToken=...&refreshToken=...&email=..."
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get current authenticated user",
        "operationId": "getCurrentUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid JWT"
          }
        }
      }
    },
    "/api/schedules": {
      "post": {
        "tags": [
          "schedules"
        ],
        "summary": "Create a new schedule",
        "operationId": "createSchedule",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateScheduleRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Schedule created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error — overlapping windows, invalid dayOfWeek, or startTime >= endTime",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "overlapping": {
                    "summary": "Availability windows overlap",
                    "value": {
                      "message": "Availability windows must not overlap"
                    }
                  },
                  "invalidTime": {
                    "summary": "Invalid time range",
                    "value": {
                      "message": "startTime must be before endTime"
                    }
                  },
                  "validation": {
                    "summary": "Validation error",
                    "value": {
                      "message": "name: Schedule name is required"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid JWT"
          }
        }
      },
      "get": {
        "tags": [
          "schedules"
        ],
        "summary": "List schedules for current user",
        "operationId": "listSchedules",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of user schedules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScheduleResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid JWT"
          }
        }
      }
    },
    "/api/schedules/{id}": {
      "put": {
        "tags": [
          "schedules"
        ],
        "summary": "Update a schedule",
        "operationId": "updateSchedule",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Schedule UUID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateScheduleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Schedule updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error — overlapping windows, invalid dayOfWeek, or startTime >= endTime",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "overlapping": {
                    "summary": "Availability windows overlap",
                    "value": {
                      "message": "Availability windows must not overlap"
                    }
                  },
                  "invalidTime": {
                    "summary": "Invalid time range",
                    "value": {
                      "message": "startTime must be before endTime"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid JWT"
          },
          "404": {
            "description": "Schedule not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "schedules"
        ],
        "summary": "Delete a schedule",
        "operationId": "deleteSchedule",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Schedule UUID"
          }
        ],
        "responses": {
          "204": {
            "description": "Schedule deleted"
          },
          "401": {
            "description": "Unauthorized — missing or invalid JWT"
          },
          "404": {
            "description": "Schedule not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/calendar/google/connect": {
      "get": {
        "tags": [
          "calendar"
        ],
        "summary": "Initiate Google Calendar OAuth2 flow",
        "operationId": "connectGoogleCalendar",
        "security": [],
        "responses": {
          "302": {
            "description": "Redirect to Google Calendar OAuth consent screen"
          }
        }
      }
    },
    "/api/calendar/google/callback": {
      "get": {
        "tags": [
          "calendar"
        ],
        "summary": "Google Calendar OAuth2 callback",
        "operationId": "googleCalendarCallback",
        "security": [],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Authorization code from Google"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to frontend with status"
          }
        }
      }
    },
    "/api/calendar/google/status": {
      "get": {
        "tags": [
          "calendar"
        ],
        "summary": "Get Google Calendar connection status",
        "operationId": "getCalendarConnectionStatus",
        "responses": {
          "200": {
            "description": "Connection status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarConnectionStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid JWT"
          }
        }
      }
    },
    "/api/calendar/google/events": {
      "get": {
        "tags": [
          "calendar"
        ],
        "summary": "Get busy slots from Google Calendar",
        "operationId": "getCalendarBusySlots",
        "parameters": [
          {
            "name": "timeMin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Start of the time period"
          },
          {
            "name": "timeMax",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "End of the time period"
          }
        ],
        "responses": {
          "200": {
            "description": "List of busy time slots",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarBusySlotsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Calendar not connected or invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "notConnected": {
                    "summary": "Calendar not connected",
                    "value": {
                      "message": "Google Calendar is not connected"
                    }
                  },
                  "invalidParams": {
                    "summary": "Invalid query parameters",
                    "value": {
                      "message": "timeMin and timeMax are required"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid JWT"
          }
        }
      },
      "post": {
        "tags": [
          "calendar"
        ],
        "summary": "Create an event in Google Calendar",
        "operationId": "createCalendarEvent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCalendarEventRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarEventResponse"
                }
              }
            }
          },
          "400": {
            "description": "Calendar not connected or validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "notConnected": {
                    "summary": "Calendar not connected",
                    "value": {
                      "message": "Google Calendar is not connected"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid JWT"
          }
        }
      }
    },
    "/api/calendar/google/events/{googleEventId}": {
      "delete": {
        "tags": [
          "calendar"
        ],
        "summary": "Delete an event from Google Calendar",
        "operationId": "deleteCalendarEvent",
        "parameters": [
          {
            "name": "googleEventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Google Calendar event ID"
          }
        ],
        "responses": {
          "204": {
            "description": "Event deleted successfully"
          },
          "400": {
            "description": "Calendar not connected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "notConnected": {
                    "summary": "Calendar not connected",
                    "value": {
                      "message": "Google Calendar is not connected"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid JWT"
          },
          "404": {
            "description": "Event not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "notFound": {
                    "summary": "Event not found",
                    "value": {
                      "message": "Event not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "description": "User password (min 6 characters)"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "User UUID"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User email address"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token"
          },
          "refreshToken": {
            "type": "string",
            "description": "JWT refresh token"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          }
        },
        "required": [
          "message"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "description": "User password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Valid refresh token"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "New JWT access token"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "availability": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Availability window UUID"
          },
          "dayOfWeek": {
            "type": "string",
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI",
              "SAT",
              "SUN"
            ],
            "description": "Day of week"
          },
          "startTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "Start time in HH:MM format (24h)"
          },
          "endTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "End time in HH:MM format (24h)"
          }
        },
        "required": [
          "id",
          "dayOfWeek",
          "startTime",
          "endTime"
        ]
      },
      "ScheduleResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Schedule UUID"
          },
          "userId": {
            "type": "string",
            "description": "Owner user UUID"
          },
          "name": {
            "type": "string",
            "description": "Schedule name"
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone (e.g. Europe/Moscow)"
          },
          "availabilities": {
            "type": "array",
            "description": "Availability windows",
            "items": {
              "$ref": "#/components/schemas/availability"
            }
          }
        },
        "required": [
          "id",
          "userId",
          "name",
          "timezone",
          "availabilities"
        ]
      },
      "CreateScheduleRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Schedule name"
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone (e.g. Europe/Moscow)"
          },
          "availabilities": {
            "type": "array",
            "description": "Availability windows (without id — created by server)",
            "items": {
              "type": "object",
              "properties": {
                "dayOfWeek": {
                  "type": "string",
                  "enum": [
                    "MON",
                    "TUE",
                    "WED",
                    "THU",
                    "FRI",
                    "SAT",
                    "SUN"
                  ],
                  "description": "Day of week"
                },
                "startTime": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "description": "Start time in HH:MM format (24h)"
                },
                "endTime": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "description": "End time in HH:MM format (24h)"
                }
              },
              "required": [
                "dayOfWeek",
                "startTime",
                "endTime"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "timezone",
          "availabilities"
        ]
      },
      "UpdateScheduleRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Schedule name"
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone (e.g. Europe/Moscow)"
          },
          "availabilities": {
            "type": "array",
            "description": "Availability windows (without id — replaces existing)",
            "items": {
              "type": "object",
              "properties": {
                "dayOfWeek": {
                  "type": "string",
                  "enum": [
                    "MON",
                    "TUE",
                    "WED",
                    "THU",
                    "FRI",
                    "SAT",
                    "SUN"
                  ],
                  "description": "Day of week"
                },
                "startTime": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "description": "Start time in HH:MM format (24h)"
                },
                "endTime": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "description": "End time in HH:MM format (24h)"
                }
              },
              "required": [
                "dayOfWeek",
                "startTime",
                "endTime"
              ]
            },
            "minItems": 1
          }
        }
      },
      "CalendarConnectionStatusResponse": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean",
            "description": "Whether Google Calendar is connected"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Google Calendar email address"
          }
        },
        "required": [
          "connected"
        ]
      },
      "CalendarBusySlot": {
